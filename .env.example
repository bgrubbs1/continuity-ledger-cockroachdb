# Never commit real values. Use contest-only accounts and secret storage.
# Managed AWS Lambda reads the URL from this encrypted SSM parameter.
DATABASE_PARAMETER_NAME=/continuity-ledger/database-url

# DATABASE_URL is for explicit local verification only; never set it in Lambda.
DATABASE_URL=

COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_CLUSTER_ID=00000000-0000-0000-0000-000000000000
COCKROACH_MCP_TOKEN=

ALLOW_LOCAL_SQLITE=false
SQLITE_PATH=
